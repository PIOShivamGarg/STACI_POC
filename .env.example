# Copy to .env and pick the forecasting model to run: lgbm | xgboost | chronos | stats
FORECAST_MODEL=lgbm

# Risk levels: ml (ML stockout probability, needs ml_risk.py to be run) | rules (days-of-stock cutoffs)
RISK_METHOD=ml

# Explanations of at-risk SKUs (explain.py). Optional: without a key a template is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
